# CozyChat v1.1.0 Docker部署环境变量示例

# ============================================================================
# 基础配置
# ============================================================================
# 后端端口（宿主机）
BACKEND_PORT=9800

# 前端端口（宿主机）
FRONTEND_PORT=8000

# ============================================================================
# 数据库配置
# ============================================================================
# PostgreSQL密码
POSTGRES_PASSWORD=your_secure_postgres_password_here

# Redis密码
REDIS_PASSWORD=your_secure_redis_password_here

# ============================================================================
# OpenAI配置
# ============================================================================
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_BASE_URL=https://oaiapi.naivehero.top/v1

# ============================================================================
# 🆕 三大人格化引擎配置（v1.1.0）
# ============================================================================

# Knowledge Engine (Cognee)
KNOWLEDGE_ENGINE_PROVIDER=cognee
COGNEE_API_URL=http://192.168.66.11:8000
COGNEE_API_TOKEN=

# UserProfile Engine (Memobase)
USERPROFILE_ENGINE_PROVIDER=memobase
MEMOBASE_PROJECT_URL=http://192.168.66.11:8019
MEMOBASE_API_KEY=secret

# ChatMemory Engine (Mem0)
CHATMEMORY_ENGINE_PROVIDER=mem0
MEM0_API_URL=http://192.168.66.11:8888
MEM0_API_KEY=

# ============================================================================
# Qdrant配置（旧引擎兼容）
# ============================================================================
QDRANT_API_KEY=

# ============================================================================
# 注意事项
# ============================================================================
# 1. 三大引擎（Cognee/Memobase/Mem0）需要单独部署
# 2. 修改引擎URL为实际的服务器地址
# 3. 不要将此文件提交到Git（已在.gitignore中）
# 4. 复制此文件为 .env 并填入实际值

