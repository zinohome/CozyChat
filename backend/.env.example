# CozyChat 环境变量配置示例
# 
# 使用说明：
# 1. 复制此文件为 .env: cp .env.example .env
# 2. 根据实际情况修改配置值
# 3. .env 文件不会提交到Git（已在 .gitignore 中）

# ==================== 应用配置 ====================
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=your-secret-key-change-this-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-this-in-production

# ==================== 安全配置 ====================
ALLOW_REGISTRATION=true

# ==================== CORS配置 ====================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ==================== 数据库配置 ====================
DATABASE_URL=postgresql+asyncpg://cozychat:password@localhost:5432/cozychat
POSTGRES_USER=cozychat
POSTGRES_PASSWORD=password
POSTGRES_DB=cozychat
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ==================== Redis配置 ====================
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# ==================== OpenAI配置 ====================
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# ==================== Sentry监控配置 ====================
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENABLE=false

# ==================== 日志配置 ====================
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
