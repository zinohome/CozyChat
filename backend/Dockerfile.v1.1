# CozyChat Backend v1.1.0 - 三大人格化引擎系统
# Multi-stage build for optimized image size

# ============================================================================
# Stage 1: Builder - 安装依赖
# ============================================================================
FROM python:3.11-slim as builder

WORKDIR /build

# 安装构建依赖
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    make \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# 复制依赖文件
COPY requirements/base.txt requirements/base.txt
COPY requirements/personalization.txt requirements/personalization.txt

# 创建虚拟环境并安装依赖
RUN python -m venv /opt/venv && \
    /opt/venv/bin/pip install --upgrade pip && \
    /opt/venv/bin/pip install --no-cache-dir \
        -r requirements/base.txt \
        -r requirements/personalization.txt

# ============================================================================
# Stage 2: Runtime - 运行环境
# ============================================================================
FROM python:3.11-slim

# 设置标签
LABEL maintainer="CozyChat Team" \
      version="1.1.0" \
      description="CozyChat Backend with Three Personalization Engines"

# 设置工作目录
WORKDIR /app

# 设置环境变量
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/opt/venv/bin:$PATH" \
    # 禁用ChromaDB遥测
    ANONYMIZED_TELEMETRY=False

# 安装运行时依赖
RUN apt-get update && apt-get install -y \
    postgresql-client \
    curl \
    && rm -rf /var/lib/apt/lists/*

# 从builder阶段复制虚拟环境
COPY --from=builder /opt/venv /opt/venv

# 复制应用代码
COPY app ./app
COPY config ./config
COPY alembic ./alembic
COPY alembic.ini .
COPY scripts ./scripts

# 创建必要的目录
RUN mkdir -p logs data && \
    chmod +x scripts/*.sh 2>/dev/null || true

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8000/v1/health || exit 1

# 暴露端口
EXPOSE 8000

# 启动命令（可以被docker-compose覆盖）
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]

