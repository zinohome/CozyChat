# ===== API配置 =====
# 后端API地址（生产环境必须配置）
# 注意：必须使用 HTTPS，不能使用 HTTP（避免混合内容错误）
# 如果使用 Caddy 反向代理，使用域名即可（不需要端口号）
# 例如：https://chat.naivehero.top（Caddy 会自动代理到后端）
VITE_API_BASE_URL=https://chat.naivehero.top

# ===== Demo模式配置 =====
VITE_DEMO_MODE=false
VITE_DEMO_USERNAME=demo
VITE_DEMO_PASSWORD=demo123

# ===== 第三方API配置（可选）=====
# 高德地图 API Key（用于前端天气工具）
VITE_AMAP_MAPS_API_KEY=

# Tavily 搜索 API Key（用于前端搜索工具）
VITE_TAVILY_API_KEY=

# ===== Sentry监控配置（可选）=====
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
VITE_APP_VERSION=0.1.2
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.1
VITE_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1.0

# ===== 日志配置 =====
VITE_LOG_LEVEL=info

