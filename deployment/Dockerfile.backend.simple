# ============================================================
# CozyChat Backend - 简化 Dockerfile
# 基于 python:3.12-slim，从本地源码构建（不 git clone）
# uvicorn 前台运行（符合 Docker 最佳实践）
# ============================================================

FROM python:3.12-slim

# 工作目录
WORKDIR /opt/cozychat/backend

# 环境变量
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/opt/cozychat/backend \
    # 禁止 sentence-transformers 自动下载模型
    SENTENCE_TRANSFORMERS_HOME=/tmp/transformers \
    TRANSFORMERS_CACHE=/tmp/transformers \
    HF_HOME=/tmp/hf \
    TORCH_HOME=/tmp/torch

# 安装系统依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libssl3 \
    libffi8 \
    portaudio19-dev \
    libsasl2-2 \
    libpq-dev \
    gcc \
    python3-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# 先单独安装 CPU 版本 PyTorch（避免下载 CUDA 版本，节省 ~1GB）
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu

# 复制并安装 Python 依赖
COPY backend/requirements/core.txt requirements/core.txt
COPY backend/requirements/cognee.txt requirements/cognee.txt
COPY backend/requirements/personalization.txt requirements/personalization.txt
RUN pip install --no-cache-dir -r requirements/core.txt && \
    pip install --no-cache-dir -r requirements/cognee.txt && \
    pip install --no-cache-dir -r requirements/personalization.txt && \
    # 固定 bcrypt 版本以兼容 passlib 1.7.4
    pip install --force-reinstall --no-cache-dir bcrypt==3.2.2

# 复制应用代码（包含 packages/ 目录下的本地 SDK）
COPY backend/ .

# 安装腾讯语音 SDK（可选，语音功能需要）
RUN if [ -f "packages/tencent-speech-sdk/setup.py" ]; then \
        pip install --no-cache-dir packages/tencent-speech-sdk; \
    fi


# 创建必要目录
RUN mkdir -p logs data

# 暴露端口
EXPOSE 8000

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=5 \
    CMD curl -f http://localhost:8000/v1/health || exit 1

# 启动脚本：先运行数据库迁移，再前台启动 uvicorn
CMD ["sh", "-c", "\
    echo '>>> 运行数据库迁移...' && \
    alembic upgrade head && \
    echo '>>> 启动应用...' && \
    exec uvicorn app.main:app \
        --host 0.0.0.0 \
        --port 8000 \
        --workers 1 \
        --log-level info \
"]
