# ===== 应用配置 =====
APP_NAME=CozyChat
APP_ENV=production
APP_DEBUG=false
APP_SECRET_KEY=your-secret-key-here-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-here-change-in-production

# ===== 安全配置 =====
ALLOW_REGISTRATION=false

# ===== Demo模式配置 =====
DEMO_MODE=false
DEMO_USERNAME=demo
DEMO_PASSWORD=demo123
DEMO_EMAIL=demo@cozychat.ai

# ===== CORS配置 =====
# 生产环境请配置实际的前端域名，支持JSON数组格式或逗号分隔
CORS_ORIGINS=["https://your-frontend-domain.com"]

# ===== 数据库配置 =====
# PostgreSQL连接URL（格式：postgresql://user:password@host:port/database）
DATABASE_URL=postgresql://cozychat:password@postgres-host:5432/cozychat
POSTGRES_USER=cozychat
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_DB=cozychat

# 数据库连接池配置
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600
DB_ECHO=false

# ===== Redis配置 =====
REDIS_URL=redis://redis-host:6379/0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=50
# Redis连接超时配置（秒）
REDIS_SOCKET_CONNECT_TIMEOUT=5.0
REDIS_SOCKET_TIMEOUT=5.0
REDIS_RETRY_ON_TIMEOUT=true
REDIS_HEALTH_CHECK_INTERVAL=30

# ===== OpenAI配置 =====
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_BASE_URL=https://oaiapi.naivehero.top/v1
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview-2024-12-17

# ===== Ollama配置（可选）=====
OLLAMA_BASE_URL=http://ollama-host:11434

# ===== 向量数据库配置 =====
# ChromaDB持久化目录（如果使用ChromaDB）
CHROMA_PERSIST_DIRECTORY=/data/chroma

# Qdrant配置（如果使用Qdrant，推荐）
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# ===== 腾讯云配置（可选）=====
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_APP_ID=

# ===== 第三方API配置（可选）=====
OPENWEATHER_API_KEY=
AMAP_MAPS_API_KEY=
TAVILY_API_KEY=

# ===== 会话标题生成配置 =====
# ⚠️ 已迁移到 backend/config/session.yaml
# 如需自定义，请修改 session.yaml 文件
# 环境变量仍可作为后备（向后兼容）

# ===== 记忆系统配置 =====
# ⚠️ 已迁移到 backend/config/memory.yaml
# 如需自定义，请修改 memory.yaml 文件
# 环境变量仍可作为后备（向后兼容）

# ===== 智能上下文配置 =====
# ⚠️ 已迁移到 backend/config/context.yaml
# 如需自定义，请修改 context.yaml 文件
# 环境变量仍可作为后备（向后兼容）

# ===== 性能监控配置 =====
# ⚠️ 已迁移到 backend/config/performance.yaml
# 如需自定义，请修改 performance.yaml 文件
# 环境变量仍可作为后备（向后兼容）

# ===== Sentry监控配置（可选）=====
SENTRY_ENABLE=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
SENTRY_SEND_DEFAULT_PII=false
SENTRY_ATTACH_STACKTRACE=true
SENTRY_MAX_BREADCRUMBS=100
SENTRY_DEBUG=false

# ===== 日志配置 =====
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

