# ============================================================
# CozyChat 一体化部署 - 统一配置文件
# 使用方法：cp simple.env.example .env，然后修改以下配置
# ============================================================

# ===== 必填项（务必修改）=====

# PostgreSQL 密码
POSTGRES_PASSWORD=change-this-strong-password

# JWT 签名密钥（32位以上随机字符串）
JWT_SECRET_KEY=change-this-jwt-secret-key-to-something-random-32chars

# 应用密钥（32位以上随机字符串）
APP_SECRET_KEY=change-this-app-secret-key-to-something-random-32chars

# OpenAI API Key
OPENAI_API_KEY=sk-your-openai-api-key-here


# ===== 可选：修改默认值 =====

# 前端对外暴露的端口（默认80，如有端口冲突可改为如 8080）
FRONTEND_PORT=80

# OpenAI Base URL（使用国内代理时修改）
OPENAI_BASE_URL=https://oaiapi.naivehero.top/v1

# OpenAI Realtime 模型
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview-2024-12-17

# 是否允许注册新用户
ALLOW_REGISTRATION=false

# 日志级别（DEBUG/INFO/WARNING/ERROR）
LOG_LEVEL=INFO


# ===== Demo 模式（可选）=====

DEMO_MODE=false
DEMO_USERNAME=demo
DEMO_PASSWORD=demo123
DEMO_EMAIL=demo@cozychat.ai


# ===== 第三方 API（可选）=====

# 高德地图 API Key（天气工具）
AMAP_MAPS_API_KEY=

# Tavily 搜索 API Key
TAVILY_API_KEY=

# OpenWeather API Key
OPENWEATHER_API_KEY=

# 高德地图（前端显示，也可在构建时传入）
VITE_AMAP_MAPS_API_KEY=


# ===== 以下为内部配置，一般无需修改 =====

POSTGRES_USER=cozychat
POSTGRES_DB=cozychat

# Redis 密码（留空表示无密码）
REDIS_PASSWORD=

# Qdrant API Key（留空表示无认证）
QDRANT_API_KEY=

# 应用版本
VITE_APP_VERSION=0.1.3
