# ============================================================
# CozyChat Frontend - 多阶段简化 Dockerfile
#
# Stage 1 (builder): 构建 Vite SPA
#   - VITE_API_BASE_URL 为空，前端使用相对路径 /v1/...
#   - Nginx 在同一容器内代理 /v1/* 到 backend，完全同源无 CORS 问题
#
# Stage 2 (server): Nginx 服务静态文件 + API 代理
# ============================================================

# ---- Stage 1: Build ----
FROM node:20-slim AS builder

WORKDIR /app

# 安装 pnpm
RUN npm install -g pnpm

# 先复制 package 文件，利用 Docker 缓存层
COPY frontend/package.json frontend/pnpm-lock.yaml ./
COPY frontend/pnpm-workspace.yaml ./

# 安装依赖
RUN pnpm install --frozen-lockfile

# 复制前端源码
COPY frontend/ .

# 构建参数（可在 docker-compose build args 中覆盖）
ARG VITE_API_BASE_URL=
ARG VITE_APP_VERSION=0.1.3
ARG VITE_LOG_LEVEL=info
ARG VITE_DEMO_MODE=false
ARG VITE_DEMO_USERNAME=demo
ARG VITE_DEMO_PASSWORD=demo123
ARG VITE_AMAP_MAPS_API_KEY=
ARG VITE_TAVILY_API_KEY=
ARG VITE_SENTRY_DSN=
ARG VITE_SENTRY_ENVIRONMENT=production

# 导出为环境变量（Vite 在构建时读取）
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL} \
    VITE_APP_VERSION=${VITE_APP_VERSION} \
    VITE_LOG_LEVEL=${VITE_LOG_LEVEL} \
    VITE_DEMO_MODE=${VITE_DEMO_MODE} \
    VITE_DEMO_USERNAME=${VITE_DEMO_USERNAME} \
    VITE_DEMO_PASSWORD=${VITE_DEMO_PASSWORD} \
    VITE_AMAP_MAPS_API_KEY=${VITE_AMAP_MAPS_API_KEY} \
    VITE_TAVILY_API_KEY=${VITE_TAVILY_API_KEY} \
    VITE_SENTRY_DSN=${VITE_SENTRY_DSN} \
    VITE_SENTRY_ENVIRONMENT=${VITE_SENTRY_ENVIRONMENT}

# 构建生产版本
RUN pnpm build

# ---- Stage 2: Serve ----
FROM nginx:stable-alpine

# 复制 Nginx 配置（含 API 代理）
COPY deployment/nginx/frontend.conf /etc/nginx/conf.d/default.conf

# 复制构建产物
COPY --from=builder /app/dist /usr/share/nginx/html

# 暴露端口
EXPOSE 80

# Nginx 前台运行
CMD ["nginx", "-g", "daemon off;"]
